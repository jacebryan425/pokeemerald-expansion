mapscripts ChartreuseCity_Gym_MapScripts {}

script ChartreuseCity_Gym_NPCScript {
    lock
    faceplayer
    if (flag(FLAG_BADGE01_GET) == TRUE) {
        msgbox("Hey, that's the Vine Badge!\n"
                "Way to go!")
    } else {
        msgbox("Welcome to the Chartreuse City Gym.\n"
                "Our leader here is Grace.\p"
                "This Gym specializes in Grass-type\n"
                "Pokémon, so any Flying or Fire-type\l"
                "Pokémon should do the trick.")
    }
    release
}

script ChartreuseCity_Gym_TrainerScript_Bethany {
    trainerbattle_single(TRAINER_BETHANY_CC, Bethany_Intro, Bethany_Outro)
    msgbox(PostBattle_Bethany, MSGBOX_AUTOCLOSE)
    waitmessage
    end
}

text Bethany_Intro {
    "If you want to face Grace, you'll\n"
    "have to get through me first!"
}

text Bethany_Outro {
    "Your Pokémon are strong!"
}

text PostBattle_Bethany {
    "Best of luck to you.\n"
    "There's still two other trainers left\l"
    "to fight before Grace."
}

script ChartreuseCity_Gym_TrainerScript_Trisha {
    trainerbattle_single(TRAINER_TRISHA_CC, Trisha_Intro, Trisha_Outro)
    msgbox(PostBattle_Trisha, MSGBOX_AUTOCLOSE)
    waitmessage
    end
}

text Trisha_Intro {
    "Grass-type Pokémon are the best!"
}

text Trisha_Outro {
    "Oh...okay."
}

text PostBattle_Trisha {
    "I love being in nature.\n"
    "It's only natural that I would choose\l"
    "to be a Grass-type trainer!"
}

script ChartreuseCity_Gym_TrainerScript_Anne {
    trainerbattle_single(TRAINER_ANNE_CC, Anne_Intro, Anne_Outro)
    msgbox(PostBattle_Anne, MSGBOX_AUTOCLOSE)
    waitmessage
    end
}

text Anne_Intro {
    "It's time to whip you into shape!"
}

text Anne_Outro {
    "But..."
}

text PostBattle_Anne {
    "Grace is right up ahead.\n"
    "You've got this!"
}

script ChartreuseCity_Gym_TrainerScript_Grace {
    lock
    faceplayer
    if (flag(FLAG_BADGE01_GET) == TRUE) {
        msgbox("Best of luck to you, {PLAYER}.")
    } else {
        msgbox("Welcome to my Gym! I'm Grant.\n"
                "I specialize in Grass-type Poké-\p"
                "...Wait a second. Are those...")
        playse(SE_PIN)
        applymovement(GRACE, moves(emote_exclamation_mark))
        waitmovement(0)
        waitse
        msgbox("They are! You have all eight badges\n"
                "from the Kanto region already?\p"
                "What's a trainer like you doing here?\p"
                "...Oh, you want to take on the Obsidian\n"
                "League? Very well then.\p"
                "As I was saying, I specialize in\n"
                "Grass-type Pokémon.\p"
                "My Pokémon will leave you all cut up!\n"
                "Get ready!")
        waitmessage
        trainerbattle_no_intro(TRAINER_LEADER_GRACE, Grace_Outro)
        if (var(VAR_RESULT) == B_OUTCOME_WON) {
            msgbox("I would have expected no less from\n"
                    "a trainer such as yourself.\p"
                    "Very well, here is the Vine Badge.")
            playfanfare(MUS_OBTAIN_BADGE)
            msgbox("{PLAYER} obtained the Vine Badge!")
            waitfanfare
            setflag(FLAG_BADGE01_GET)
            addvar(VAR_CHARTREUSE_CITY_STATE, 1)
            msgbox("I would also like to give you this.")
            giveitem(ITEM_TM09)
            msgbox("That's the TM for Bullet Seed, one\n"
                    "of my favorite moves.\p"
                    "Teach it to a Grass-type Pokémon.\p"
                    "In Kanto, TMs break after one use,\n"
                    "but here in Admiro, you can use TMs as\l"
                    "many times as you'd like. Neat, huh?\p"
                    "Best of luck to you, {PLAYER}.")
        }
    }
    release
}

text Grace_Outro {
    "I knew I didn't stand a chance."
}
