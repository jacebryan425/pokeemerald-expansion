}

script MarigoldForest_NPCScript_SuicuneLore {
    lock
    faceplayer
    msgbox("My mother once told me a story about a\n"
            "Legendary Pokémon that lives in this\l"
            "forest.\p"
            "She said that it hides in the trees,\n"
            "and only shows itself to trainers who\l"
            "are pure of heart.")
    release
}

script MarigoldForest_NPCScript_Headbutt {
    lock
    faceplayer
    msgbox("Did you know that certain Pokémon can\n"
            "only be found living in trees?\p"
            "You can find them with a move called\n"
            "Headbutt.\p"
            "Would you like me to teach Headbutt to\n"
            "one of your Pokémon?", MSGBOX_YESNO)
    if (var(VAR_RESULT) == YES) {
        msgbox("Alright, which Pokémon wants to learn\n"
                "how to Headbutt?")
        setvar(VAR_0x8005, MOVE_HEADBUTT)
        call(HeadbuttTutor_EventScript_OpenPartyMenu)
        if (var(VAR_RESULT) == 0) {
            msgbox("Okay then. Come back if you ever\n"
                    "change your mind.")
        }
        msgbox("Teaching your Pokémon this move\n"
                "is much safer than using your own head.\p"
                "I hope you find tons of new\n"
                "Pokémon!")
    } else {
        msgbox("Okay then. Come back if you ever\n"
                "change your mind.")
    }
    release
}

script HeadbuttTutor_EventScript_OpenPartyMenu {
    special(ChooseMonForMoveTutor)
    waitstate
	lock
	faceplayer
	return
}

script MarigoldForest_SignScript_Location {
    lock
    msgbox("{COLOR GREEN}{SHADOW LIGHT_GREEN}Marigold Forest.")
    release
}

script MarigoldForest_SignScript_TrainerTips {
    lock
    msgbox("If you ever want to avoid wild\n"
            "Pokémon encounters, use a Repel!\p"
            "You can buy them at any Poké Mart.")
    release
}

script MarigoldForest_ItemScript_Potion {
    finditem(ITEM_POTION, 1)
    setflag(FLAG_ITEM_MARIGOLD_FOREST_POTION)
}

script MarigoldForest_ItemScript_Antidote {
    finditem(ITEM_ANTIDOTE, 3)
    setflag(FLAG_ITEM_MARIGOLD_FOREST_ANTIDOTE)
}

script MarigoldForest_ItemScript_GreatBall {
    finditem(ITEM_GREAT_BALL, 1)
    setflag(FLAG_ITEM_MARIGOLD_FOREST_GREAT_BALL)
}
