mapscripts MarigoldForest_MapScripts {}

script MarigoldForest_TrainerScript_Ted {
    trainerbattle_single(TRAINER_TED_MARIGOLDFOREST, Ted_Intro, Ted_Outro)
    msgbox(PostBattle_Ted, MSGBOX_AUTOCLOSE)
    waitmessage
    end
}

text Ted_Intro {
    "Bug Pokémon aren't very strong,\n"
    "but I want to catch them all!"
}

text Ted_Outro {
    "See? Not very strong."
}

text PostBattle_Ted {
    "Bug Pokémon are so cool!\p"
    "I know other people think they're icky,\n"
    "but I just love them!"
}

script MarigoldForest_TrainerScript_Gene {
    trainerbattle_single(TRAINER_GENE_MARIGOLDFOREST, Gene_Intro, Gene_Outro)
    msgbox(PostBattle_Gene, MSGBOX_AUTOCLOSE)
    waitmessage
    end
}

text Gene_Intro {
    "This place is great! It's filled to the\n"
