mapscripts Route1_MapScripts {
    MAP_SCRIPT_ON_TRANSITION{
        if (var(VAR_MARIGOLD_TOWN_STATE) == 1) {
            setflag(FLAG_HIDE_POTION_NPC)
            removeobject(POTION_NPC)
        }
    }
}

script Route1_EventScript_Sign {
    lock
    msgbox("{COLOR GREEN}{SHADOW LIGHT_GREEN}Route 1.")
    release
}

script Route1_EventScript_TrainerTip1 {
    lock
    msgbox("Be careful walking through the\n"
            "tall grass!\p"
            "Wild Pokémon could catch you off guard\n"
            "at any moment.")
    release
}

script Route1_EventScript_TrainerTip2 {
    lock
    msgbox("Routes are full of fellow trainers\n"
            "looking to hone their skills.\p"
            "If one locks eyes with you,\n"
            "you must battle!")
    release
}

script Route1_EventScript_TrainerTip3 {
    lock
    msgbox("This region is full of hidden areas.\p"
            "Use the skills you learn and\n"
            "a little bit of imagination to discover\l"
            "them all.")
    release
}

script Route1_EventScript_Zigzagoon1 {
    lock
    if (var(VAR_ROUTE_1_STATE) == 1) {
        setwildbattle(SPECIES_ZIGZAGOON, 3, ITEM_NONE)
        playmoncry(SPECIES_ZIGZAGOON, CRY_MODE_ENCOUNTER)
        msgbox("Zig-zig, Zigzagoon-goon!")
        waitmoncry
        dowildbattle
        specialvar(VAR_RESULT, GetBattleOutcome)
        if (var(VAR_RESULT) == B_OUTCOME_CAUGHT || var(VAR_RESULT) == B_OUTCOME_WON || var(VAR_RESULT) == B_OUTCOME_RAN) {
            playmoncry(SPECIES_ZIGZAGOON, CRY_MODE_WEAK)
            msgbox("Zig-za...goon...")
            waitmoncry
            closemessage
            delay(30)
            applymovement(ZIGZAGOON_1, moves(walk_left * 4, walk_down * 10))
            waitmovement(0)
            setflag(FLAG_HIDE_ZIGZAGOON_1)
            removeobject(ZIGZAGOON_1)
            applymovement(OBJ_EVENT_ID_PLAYER, moves(face_down))
            applymovement(ZIGZAGOON_2, moves(face_up))
            waitmovement(0)
            setwildbattle(SPECIES_ZIGZAGOON, 3, ITEM_NONE)
            playmoncry(SPECIES_ZIGZAGOON, CRY_MODE_ENCOUNTER)
            msgbox("Zig-zig, Zigzagoon-goon!")
            waitmoncry
            dowildbattle
            specialvar(VAR_RESULT, GetBattleOutcome)
            if (var(VAR_RESULT) == B_OUTCOME_CAUGHT || var(VAR_RESULT) == B_OUTCOME_WON || var(VAR_RESULT) == B_OUTCOME_RAN) {
                playmoncry(SPECIES_ZIGZAGOON, CRY_MODE_WEAK)
                msgbox("Zig-za...goon...")
                waitmoncry
                closemessage
                delay(30)
                applymovement(ZIGZAGOON_2, moves(walk_left * 4, walk_down * 10))
                waitmovement(0)
                setflag(FLAG_HIDE_ZIGZAGOON_2)
                removeobject(ZIGZAGOON_2)
            }
        }
    } else {
        playmoncry(SPECIES_ZIGZAGOON, CRY_MODE_NORMAL)
        msgbox("Zig-zig, Zigzagoon-goon!")
        waitmoncry
    }
    release
}

script Route1_EventScript_Zigzagoon2 {
    lock
    if (var(VAR_ROUTE_1_STATE) == 1) {
        setwildbattle(SPECIES_ZIGZAGOON, 3, ITEM_NONE)
        playmoncry(SPECIES_ZIGZAGOON, CRY_MODE_ENCOUNTER)
        msgbox("Zig-zig, Zigzagoon-goon!")
        waitmoncry
        dowildbattle
        specialvar(VAR_RESULT, GetBattleOutcome)
        if (var(VAR_RESULT) == B_OUTCOME_CAUGHT || var(VAR_RESULT) == B_OUTCOME_WON || var(VAR_RESULT) == B_OUTCOME_RAN) {
            playmoncry(SPECIES_ZIGZAGOON, CRY_MODE_WEAK)
            msgbox("Zig-za...goon...")
            waitmoncry
            closemessage
            delay(30)
            applymovement(ZIGZAGOON_2, moves(walk_left * 4, walk_down * 10))
            waitmovement(0)
            setflag(FLAG_HIDE_ZIGZAGOON_2)
            removeobject(ZIGZAGOON_2)
            if (var(VAR_FACING) == DIR_SOUTH) {
                applymovement(OBJ_EVENT_ID_PLAYER, moves(face_left))
                waitmovement(0)
            } else {
                applymovement(ZIGZAGOON_1, moves(walk_down, walk_right))
                waitmovement(0)
            }
            setwildbattle(SPECIES_ZIGZAGOON, 3, ITEM_NONE)
            playmoncry(SPECIES_ZIGZAGOON, CRY_MODE_ENCOUNTER)
            msgbox("Zig-zig, Zigzagoon-goon!")
            waitmoncry
            dowildbattle
            specialvar(VAR_RESULT, GetBattleOutcome)
            if (var(VAR_RESULT) == B_OUTCOME_CAUGHT || var(VAR_RESULT) == B_OUTCOME_WON || var(VAR_RESULT) == B_OUTCOME_RAN) {
                playmoncry(SPECIES_ZIGZAGOON, CRY_MODE_WEAK)
                msgbox("Zig-za...goon...")
                waitmoncry
                closemessage
                delay(30)
                applymovement(ZIGZAGOON_1, moves(walk_left * 4, walk_down * 10))
                waitmovement(0)
                setflag(FLAG_HIDE_ZIGZAGOON_1)
                removeobject(ZIGZAGOON_1)
            }
        }
    } else {
        playmoncry(SPECIES_ZIGZAGOON, CRY_MODE_NORMAL)
        msgbox("Zig-zig, Zigzagoon-goon!")
        waitmoncry
    }
    release
}

script Route1_EventScript_PotionNPC {
    lock
    faceplayer
    if (flag(FLAG_GAVE_POTION) == true) {
        msgbox("Come visit me at the Marigold\n"
                "Poké Mart if you'd ever like to\l"
                "purchase more items.")
    } elif (flag(FLAG_HIDE_ZIGZAGOON_1) == true && flag(FLAG_HIDE_ZIGZAGOON_2) == true) {
        msgbox("Thank you for chasing off those\n"
                "Zigzagoon!\p"
                "Now I can get back to town in time\n"
                "for my shift.\p"
                "Here's something to express my\n"
                "gratitude.")
        giveitem(ITEM_POTION, 5)
        setflag(FLAG_GAVE_POTION)
        msgbox("Come visit me at the Marigold\n"
                "Poké Mart if you'd ever like to\l"
                "purchase more items.")
    } elif (var(VAR_ROUTE_1_STATE) == 1) {
        msgbox("Please chase those Zigzagoon off\n"
                "for me!\p"
                "I'm going to be late for my shift!")
    } elif (flag(FLAG_RECEIVED_DEX_FROM_ASPEN) == TRUE) {
        msgbox("Those scary Zigzagoon chased me and\n"
                "then blocked off the path!\p"
                "How am I going to make it back to town?!\p"
                "Oh...that looks like a Pokédex!\n"
                "Surely you're strong enough to chase\l"
                "them off for me!")
        addvar(VAR_ROUTE_1_STATE, 1)
    } else {
        msgbox("Those scary Zigzagoon chased me and\n"
                "then blocked off the path!\p"
                "How am I going to make it back to town?!")
    }
    release
}

script Route1_EventScript_Bobby {
    trainerbattle_single(TRAINER_BOBBY_ROUTE1, Bobby_Intro, Bobby_Outro)
    msgbox(PostBattle_Bobby, MSGBOX_AUTOCLOSE)
    waitmessage
    end
}

script Route1_EventScript_Eli {
    trainerbattle_single(TRAINER_ELI_ROUTE1, Eli_Intro, Eli_Outro)
    msgbox(PostBattle_Eli, MSGBOX_AUTOCLOSE)
    waitmessage
    end
}

text Bobby_Intro {
    "Are you from here?\n"
    "I haven't seen you around before."
}

text Bobby_Outro {
    "Wow, you're strong!"
}

text PostBattle_Bobby {
    "I want to be as strong as you one day."
}

text Eli_Intro {
    "Do you want to see my new Pokémon?"
}

text Eli_Outro {
    "No! My new Pokémon!"
}

text PostBattle_Eli {
    "Different Pokémon seem to show up\n"
    "here during different times of day."
}